---
const features = [
  { icon: '🏗️', title: 'Zero Dependencies', desc: 'Pure Bash 3.2 — no package managers, no runtimes' },
  { icon: '🔄', title: 'Native Auto-Updater', desc: 'Run `gitsetu update` to atomically apply patches and upgrades.' },
  { icon: '🛡️', title: 'Zero-Trust SSH', desc: 'OpenSSH Include architecture ensures global config is NEVER mutated.' },
  { icon: '📦', title: 'Encrypted Backup', desc: 'Export/restore identity state with OpenSSL AES-256 encryption' },
  { icon: '⚡', title: 'Shell Prompt', desc: 'Active profile in $PS1 — zero subshells, ~2ms execution' },
  { icon: '🩺', title: 'Diagnostic Doctor', desc: 'Built-in tools to instantly diagnose agent drift and config health' },
  { icon: '⌨️', title: 'Autocompletion', desc: 'Rich <TAB> completion for commands and profile names in Bash/Zsh' },
  { icon: '🌐', title: 'Global Fallback', desc: 'Never leave unmanaged repositories broken. Graceful defaults.' }
];
---

<section class="features section" id="features">
  <div class="container">
    <h2 class="section-title">
      Everything you need.<br />
      <span class="accent-text">Nothing you don't.</span>
    </h2>

    <div class="features-grid">
      {features.map((feature) => (
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">{feature.icon}</div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-secondary);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .feature-card {
    background: var(--gradient-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: var(--space-xl) var(--space-lg);
    text-align: center;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
    border-color: var(--accent-primary);
  }

  .feature-icon {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-md);
  }

  .feature-title {
    font-size: var(--text-base);
    color: var(--text-heading);
    margin-bottom: var(--space-sm);
  }

  .feature-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
