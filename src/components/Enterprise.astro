---
const trustSignals = [
  {
    title: 'Fleet-Wide Compliance',
    desc: 'Standardize cryptographic signing and identity isolation across hundreds of workstations instantly.'
  },
  {
    title: 'CI/CD Headless Ready',
    desc: 'Fail-safe routing for CI runners. Eliminates the non-human identity credential risk in automated pipelines.'
  },
  {
    title: 'Zero-State Provisioning',
    desc: 'Onboard new engineers in seconds. Encrypted profile portability guarantees an identical secure environment anywhere.'
  },
  {
    title: 'Agentic Development Stack',
    desc: 'The missing identity layer for the AI era. Provide structured, scoped cryptographic authorization for autonomous agents.'
  }
];
---

<section class="enterprise section reveal" id="enterprise">
  <div class="container">
    <div class="enterprise-header reveal delay-100">
      <h2 class="section-title">Architected for human and <span class="accent-text">non-human identities.</span></h2>
      <p class="section-subtitle">A unified identity fabric that scales from local developer environments to fleet-wide deployments and headless pipelines.</p>
    </div>
    
    <div class="signals-grid reveal delay-200">
      {trustSignals.map((signal) => (
        <div class="signal-card">
          <h3 class="signal-title">{signal.title}</h3>
          <p class="signal-desc">{signal.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .enterprise {
    background: var(--bg-primary);
  }

  .enterprise-header {
    margin-bottom: var(--space-4xl);
  }

  .signals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .signal-card {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: border-color var(--transition-base);
  }

  .signal-card:hover {
    border-color: var(--border-card);
  }

  .signal-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-heading);
    margin-bottom: var(--space-sm);
  }

  .signal-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .signals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .signals-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
