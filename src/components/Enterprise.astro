---
const trustSignals = [
  {
    title: 'Zero-Trust Identity Guard',
    desc: 'Fail-closed architecture definitively blocks commits if your active email does not strictly match the required profile.'
  },
  {
    title: 'Atomic POSIX Locks',
    desc: 'Safe for highly parallel environments. POSIX mkdir-based locks with stale reaping guarantee zero race conditions.'
  },
  {
    title: 'Hardware-Backed Keys',
    desc: 'Natively generates Ed25519 and FIDO2 (ed25519-sk) hardware-backed SSH keys out of the box.'
  },
  {
    title: 'Resilient Filesystem Swaps',
    desc: 'Temporary file generation with atomic mv swapping guarantees no partial writes or configuration corruption.'
  }
];
---

<section class="enterprise section">
  <div class="container">
    <h2 class="section-title">The identity security layer for teams and CI/CD.</h2>
    
    <div class="signals-grid">
      {trustSignals.map((signal) => (
        <div class="signal-card">
          <h3 class="signal-title">{signal.title}</h3>
          <p class="signal-desc">{signal.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .enterprise {
    background: var(--bg-primary);
  }

  .signals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .signal-card {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: border-color var(--transition-base);
  }

  .signal-card:hover {
    border-color: var(--border-card);
  }

  .signal-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-heading);
    margin-bottom: var(--space-sm);
  }

  .signal-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .signals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .signals-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
