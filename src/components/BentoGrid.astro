---
---

<section class="bento-section section reveal" id="features">
  <div class="bento-container container">
    <div class="bento-header reveal delay-100">
      <h2 class="section-title">A complete <span class="accent-text">Zero-Trust</span> architecture.</h2>
      <p class="section-subtitle">We didn't just build a Git alias. We built a fail-closed orchestration engine that guarantees your identity never leaks.</p>
    </div>

    <div class="bento-grid">
      
      <!-- Card 1: The Boundary (2x2) -->
      <div class="bento-card span-2x2 reveal delay-200">
        <div class="bento-visual card-1-visual">
          <div class="lock-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div class="config-lines">
            <div class="line w-3/4"></div>
            <div class="line w-1/2"></div>
            <div class="line w-full"></div>
            <div class="line w-5/6"></div>
          </div>
        </div>
        <div class="bento-content">
          <h3>Zero-Trust Identity Firewall</h3>
          <p>GitSetu seamlessly orchestrates native Git <code>includeIf</code> directives to physically sandbox your repositories. Your corporate keys and personal credentials never cross the file boundary.</p>
        </div>
      </div>

      <!-- Card 2: Performance (1x1) -->
      <div class="bento-card span-1x1 reveal delay-300">
        <div class="bento-visual metric-visual">
          <span class="metric-value">&lt; 2<span class="metric-unit">ms</span></span>
        </div>
        <div class="bento-content">
          <h3>Zero Latency</h3>
          <p>Pure Bash 3.2 execution means routing happens instantly.</p>
        </div>
      </div>

      <!-- Card 3: Keychain (1x1) -->
      <div class="bento-card span-1x1 reveal delay-400">
        <div class="bento-visual icon-visual">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="accent-icon"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
        </div>
        <div class="bento-content">
          <h3>Hardware FIDO2</h3>
          <p>Native support for YubiKey (<code>ed25519-sk</code>) bootstrapping.</p>
        </div>
      </div>

      <!-- Card 4: Identity Guard (2x1) -->
      <div class="bento-card span-2x1 reveal delay-200">
        <div class="bento-visual card-2-visual">
          <div class="fake-terminal">
            <div class="term-text"><span class="prompt">~ ❯</span> git commit</div>
            <div class="term-text error">⚠ Identity mismatch detected!</div>
            <div class="term-text error">Commit blocked.</div>
          </div>
        </div>
        <div class="bento-content">
          <h3>Pre-Commit Guard</h3>
          <p>A fail-closed hook that physically blocks commits if your active email doesn't strictly match the required profile.</p>
        </div>
      </div>

      <!-- Card 5: Interactive Doctor (1x1) -->
      <div class="bento-card span-1x1 reveal delay-300">
        <div class="bento-visual card-2-visual" style="min-height: 120px;">
          <div class="fake-terminal">
            <div class="term-text"><span class="prompt">~ ❯</span> gitsetu doctor</div>
            <div class="term-text success">✓ Hooks verified</div>
          </div>
        </div>
        <div class="bento-content">
          <h3>Self-Healing Doctor</h3>
          <p>Built-in interactive diagnostics to verify and repair your installation instantly.</p>
        </div>
      </div>

      <!-- Card 6: Encrypted Backup (3x1) -->
      <div class="bento-card span-3x1 reveal delay-400">
        <div class="bento-content horizontal">
          <div class="text-group">
            <h3>Encrypted Profile Backup</h3>
            <p>Export your entire identity architecture. GitSetu uses AES-256 OpenSSL encryption to securely backup and restore your profiles across machines.</p>
          </div>
          <div class="visual-group">
            <div class="fake-terminal action-terminal">
              <div class="term-text"><span class="prompt">Run</span> gitsetu backup --encrypt</div>
              <div class="term-text success">✓ Profiles packed to gitsetu.enc</div>
              <div class="term-text success">✓ AES-256 encryption applied</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .bento-header {
    margin-bottom: var(--space-4xl);
  }

  .bento-container {
    container-type: inline-size;
    container-name: bento;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(220px, auto);
    grid-auto-flow: dense;
    gap: var(--space-md);
    max-width: 1100px;
    margin: 0 auto;
  }

  .bento-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-base);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  /* Deep Space Hover Glow using pseudo-element */
  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px; /* border width */
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.3) 0%, transparent 50%, rgba(255, 255, 255, 0.1) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
    z-index: 10;
  }

  .bento-card:hover {
    background: var(--bg-tertiary);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px var(--accent-glow);
    transform: translateY(-2px);
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  /* Grid Spanning */
  .span-2x2 { grid-column: span 2; grid-row: span 2; }
  .span-2x1 { grid-column: span 2; grid-row: span 1; }
  .span-1x1 { grid-column: span 1; grid-row: span 1; }
  .span-3x1 { grid-column: span 3; grid-row: span 1; }

  /* Content Inner */
  .bento-content {
    padding: var(--space-lg) var(--space-xl);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: relative;
    z-index: 2;
  }

  .bento-content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--text-heading);
  }

  .bento-content p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .bento-content code {
    background: var(--bg-code);
    color: var(--accent-primary);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    border: 1px solid var(--border-subtle);
  }

  /* Visuals Area */
  .bento-visual {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.01);
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }

  /* Card 1 Visual: Lock & Config */
  .card-1-visual {
    min-height: 240px;
    background: radial-gradient(circle at center, rgba(0, 229, 255, 0.08) 0%, transparent 60%);
  }
  
  .lock-icon {
    position: absolute;
    color: var(--accent-primary);
    z-index: 2;
    background: var(--bg-code);
    padding: var(--space-md);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-accent);
    box-shadow: 0 0 20px var(--accent-glow-strong);
  }

  .config-lines {
    width: 80%;
    opacity: 0.2;
  }
  .line { height: 6px; background: var(--text-muted); border-radius: 3px; margin-bottom: 12px; }
  .w-3\/4 { width: 75%; }
  .w-1\/2 { width: 50%; }
  .w-full { width: 100%; }
  .w-5\/6 { width: 83%; }

  /* Card 2 Visual: Terminal Error */
  .card-2-visual {
    min-height: 140px;
    align-items: flex-start;
    padding: var(--space-lg);
    background: var(--bg-code);
  }

  .fake-terminal {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    width: 100%;
  }
  .fake-terminal .prompt { color: var(--accent-primary); margin-right: 8px; }
  .fake-terminal .error { color: var(--color-error); margin-top: 8px; font-weight: 500; }
  .fake-terminal .success { color: var(--color-success); margin-top: 8px; font-weight: 500; }

  .action-terminal {
    background: var(--bg-primary);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  /* Metric Visual */
  .metric-visual {
    min-height: 120px;
  }
  .metric-value {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--text-heading);
    letter-spacing: -0.05em;
  }
  .metric-unit {
    font-size: 1.5rem;
    color: var(--accent-primary);
  }

  /* Icon Visual */
  .icon-visual {
    min-height: 120px;
  }
  .accent-icon {
    color: var(--accent-primary);
    width: 48px;
    height: 48px;
  }

  /* Horizontal Layout (Card 5) */
  .horizontal {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }
  .text-group { flex: 1; }
  .visual-group { flex: 1; width: 100%; }

  /* Removed rotation CSS */

  /* Container Queries based on `.bento-container` size */
  @container bento (max-width: 900px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr;
    }
    .span-2x2, .span-3x1 {
      grid-column: span 2;
    }
  }

  @container bento (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .span-2x2, .span-2x1, .span-3x1, .span-1x1 {
      grid-column: span 1;
    }
    .horizontal {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }
</style>
