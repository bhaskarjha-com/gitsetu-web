---
---

<div class="terminal-window" aria-label="Terminal demo showing GitSetu setup">
  <div class="terminal-header">
    <div class="traffic-lights">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
    </div>
    <span class="terminal-title">gitsetu — bash</span>
  </div>
  <div class="terminal-body" id="terminal-demo">
    <div class="terminal-line">
      <span class="prompt">~ ❯</span>
      <span class="command" data-delay="0">gitsetu setup</span>
    </div>
    <div class="terminal-line output" data-delay="600">
      <span>  Profile name: <span class="highlight">work</span></span>
    </div>
    <div class="terminal-line output" data-delay="900">
      <span>  Git email: <span class="highlight">dev@company.com</span></span>
    </div>
    <div class="terminal-line output" data-delay="1200">
      <span>  Directory: <span class="highlight">~/work</span></span>
    </div>
    <div class="terminal-line output" data-delay="1600">
      <span class="success">  ✓ SSH key generated: ~/.ssh/id_ed25519_work</span>
    </div>
    <div class="terminal-line output" data-delay="1900">
      <span class="success">  ✓ Git config written: ~/.config/gitsetu/work.gitconfig</span>
    </div>
    <div class="terminal-line output" data-delay="2200">
      <span class="success">  ✓ SSH config updated: ~/.ssh/config</span>
    </div>
    <div class="terminal-line output" data-delay="2500">
      <span class="success">  ✓ Profile 'work' created successfully</span>
    </div>

    <div class="terminal-line" data-delay="3200">
      <span class="prompt">~ ❯</span>
      <span class="command">cd ~/work/my-api && git commit -m "fix: auth bug"</span>
    </div>
    <div class="terminal-line output" data-delay="3700">
      <span>  Author: Aditya Kumar &lt;dev@company.com&gt; <span class="accent" style="white-space: nowrap">← correct</span></span>
    </div>
  </div>
</div>

<script>
  // Progressive reveal & typing animation
  const terminal = document.getElementById('terminal-demo');
  if (terminal) {
    const lines = terminal.querySelectorAll('.terminal-line');
    
    // Initial hide
    lines.forEach(line => {
      (line as HTMLElement).style.opacity = '0';
      (line as HTMLElement).style.transform = 'translateY(4px)';
      
      const cmd = line.querySelector('.command');
      if (cmd) {
        (cmd as HTMLElement).dataset.text = cmd.textContent || '';
        cmd.textContent = '';
      }
    });

    const typeCommand = (cmd: HTMLElement, text: string, callback: () => void) => {
      let i = 0;
      cmd.innerHTML = '<span class="cursor">█</span>';
      const cursor = cmd.querySelector('.cursor') as HTMLElement;
      
      const interval = setInterval(() => {
        if (i < text.length) {
          cmd.insertBefore(document.createTextNode(text.charAt(i)), cursor);
          i++;
        } else {
          clearInterval(interval);
          cursor.classList.add('blink');
          setTimeout(() => {
            cursor.remove();
            callback();
          }, 300); // let it blink a few times then remove
        }
      }, 40); // typing speed
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            lines.forEach((line) => {
              const delay = parseInt((line as HTMLElement).dataset.delay || '0', 10);
              const isOutput = line.classList.contains('output');
              
              setTimeout(() => {
                (line as HTMLElement).style.transition = 'opacity 0.2s ease, transform 0.2s ease';
                (line as HTMLElement).style.opacity = '1';
                (line as HTMLElement).style.transform = 'translateY(0)';
                
                const cmd = line.querySelector('.command') as HTMLElement;
                if (cmd) {
                  const text = cmd.dataset.text || '';
                  typeCommand(cmd, text, () => {});
                }
              }, delay);
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(terminal);
  }
</script>

<style>
  .terminal-window {
    width: 100%;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
  }

  .traffic-lights {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .terminal-body {
    padding: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.8;
    min-height: 340px;
    overflow-x: auto;
    text-align: left;
  }

  .terminal-line {
    white-space: pre-wrap;
    word-break: break-all;
  }

  .terminal-line + .terminal-line:not(.output) {
    margin-top: var(--space-lg);
  }

  .prompt {
    color: var(--accent-primary);
    margin-right: 8px;
    user-select: none;
    font-weight: 700;
    text-shadow: 0 0 8px var(--accent-glow-strong);
  }

  .command {
    color: var(--text-heading);
    font-weight: 400;
  }

  .cursor {
    display: inline-block;
    color: var(--accent-primary);
    margin-left: 2px;
    vertical-align: baseline;
  }
  
  .cursor.blink {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .output {
    color: var(--text-secondary);
  }

  .success {
    color: var(--color-success);
    text-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
  }

  .highlight {
    color: var(--text-heading);
    font-weight: 600;
  }

  .accent {
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .terminal-body {
      padding: var(--space-md);
      font-size: var(--text-xs);
      min-height: 280px;
    }
  }
</style>
