---
---

<div class="terminal-window" aria-label="Interactive Terminal showing GitSetu setup">
  <div class="terminal-header">
    <div class="traffic-lights">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
    </div>
    <span class="terminal-title">gitsetu — bash</span>
    
    <div class="terminal-modes">
      <button class="mode-btn active" id="mode-demo">Auto-Demo</button>
      <button class="mode-btn" id="mode-interactive">Interactive</button>
    </div>
  </div>
  
  <div class="terminal-body" id="terminal-container" style="height: 340px; width: 100%;">
    <!-- Xterm.js will mount here -->
  </div>
  
  <div class="terminal-hint" id="terminal-hint">
    Click terminal to take control
  </div>
</div>

<script>
  import { Terminal } from '@xterm/xterm';
  import { FitAddon } from '@xterm/addon-fit';
  import '@xterm/xterm/css/xterm.css';

  // Module-scoped state for perfect lifecycle management across Astro View Transitions
  let term: Terminal | null = null;
  let fitAddon: FitAddon | null = null;
  let demoTimeout: any = null;
  let processingInterval: any = null;
  let observer: IntersectionObserver | null = null;
  
  let isAutoDemo = true;
  let setupState = 'IDLE';
  let currentLine = '';
  let profileName = '';

  const prompt = '\x1b[1;32m~\x1b[0m \x1b[1;36m❯\x1b[0m ';

  // Global resize handler
  const handleResize = () => {
    try { if (fitAddon) fitAddon.fit(); } catch (e) {}
  };

  function cleanup() {
    if (demoTimeout) clearTimeout(demoTimeout);
    if (processingInterval) clearInterval(processingInterval);
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    window.removeEventListener('resize', handleResize);
    
    if (term) {
      term.dispose();
      term = null;
    }
    
    isAutoDemo = true;
    setupState = 'IDLE';
    currentLine = '';
    profileName = '';
  }

  // Astro View Transitions lifecycle hooks
  document.addEventListener('astro:before-swap', cleanup);

  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('terminal-container');
    const demoBtn = document.getElementById('mode-demo');
    const interactiveBtn = document.getElementById('mode-interactive');
    const hint = document.getElementById('terminal-hint');
    
    if (!container) return; // We are on another page (e.g. /docs)
    
    // Enforce strict cleanup before re-initializing to prevent memory leaks
    cleanup();
    container.innerHTML = '';

    term = new Terminal({
      cursorBlink: true,
      fontFamily: 'JetBrains Mono, monospace',
      fontSize: 13,
      theme: {
        background: 'transparent',
        foreground: '#d4d4d8',
        cursor: '#00e5ff',
        black: '#000000',
        red: '#ff5f56',
        green: '#27c93f',
        yellow: '#ffbd2e',
        blue: '#00e5ff',
        magenta: '#ff79c6',
        cyan: '#8be9fd',
        white: '#bfbfbf'
      },
      allowTransparency: true,
      disableStdin: false
    });

    fitAddon = new FitAddon();
    term.loadAddon(fitAddon);
    term.open(container);
    
    setTimeout(() => handleResize(), 100);
    window.addEventListener('resize', handleResize);

    // --- HYBRID LOGIC ---

    function setInteractiveMode() {
      if (!isAutoDemo || !term) return;
      isAutoDemo = false;
      clearTimeout(demoTimeout);
      clearInterval(processingInterval);
      
      demoBtn?.classList.remove('active');
      interactiveBtn?.classList.add('active');
      if (hint) hint.innerHTML = 'Type <kbd>gitsetu setup</kbd> and hit Enter';
      
      term.clear();
      term.write('\x1b[3mSandbox active. Try typing \x1b[33mgitsetu setup\x1b[0m\x1b[3m.\x1b[0m\r\n\r\n');
      term.write(prompt);
      currentLine = '';
      setupState = 'IDLE';
    }

    function setDemoMode() {
      if (isAutoDemo || !term) return;
      isAutoDemo = true;
      
      interactiveBtn?.classList.remove('active');
      demoBtn?.classList.add('active');
      if (hint) hint.innerHTML = 'Click terminal to take control';
      
      term.clear();
      currentLine = '';
      setupState = 'IDLE';
      runAutoDemo();
    }

    demoBtn?.addEventListener('click', setDemoMode);
    interactiveBtn?.addEventListener('click', setInteractiveMode);

    term.onKey(() => setInteractiveMode());
    container.addEventListener('click', () => setInteractiveMode());

    // --- AUTO-DEMO ENGINE ---
    
    const typeText = async (text: string, speed = 45) => {
      for (let i = 0; i < text.length; i++) {
        if (!isAutoDemo || !term) return false;
        term.write(text.charAt(i));
        await new Promise(r => { demoTimeout = setTimeout(r, speed) });
      }
      return true;
    };

    const wait = async (ms: number) => {
      await new Promise(r => { demoTimeout = setTimeout(r, ms) });
    };

    const runAutoDemo = async () => {
      if (!isAutoDemo || !term) return;
      term.write(prompt);
      await wait(1000);
      
      if (!(await typeText('gitsetu setup', 60))) return;
      await wait(300);
      if (!isAutoDemo || !term) return;
      term.write('\r\n  Profile name: ');
      await wait(600);
      if (!(await typeText('work', 80))) return;
      
      await wait(300);
      if (!isAutoDemo || !term) return;
      term.write('\r\n  Git email: ');
      await wait(500);
      if (!(await typeText('dev@company.com', 50))) return;
      
      await wait(300);
      if (!isAutoDemo || !term) return;
      term.write('\r\n  Directory: ');
      await wait(400);
      if (!(await typeText('~/work', 60))) return;
      
      await wait(300);
      if (!isAutoDemo || !term) return;
      term.write('\r\n  \x1b[36mGenerating cryptographic keys\x1b[0m');
      
      for(let i = 0; i < 3; i++) {
        await wait(400);
        if(!isAutoDemo || !term) return;
        term.write('.');
      }
      
      await wait(200);
      if(!isAutoDemo || !term) return;
      term.write('\x1b[2K\r'); // Erase line
      term.write(`  \x1b[32m✓\x1b[0m SSH key generated: ~/.ssh/id_ed25519_work\r\n`);
      await wait(300);
      if(!isAutoDemo || !term) return;
      term.write(`  \x1b[32m✓\x1b[0m Git config written: ~/.config/gitsetu/work.gitconfig\r\n`);
      await wait(300);
      if(!isAutoDemo || !term) return;
      term.write(`  \x1b[32m✓\x1b[0m SSH config updated: ~/.ssh/config\r\n`);
      await wait(400);
      if(!isAutoDemo || !term) return;
      term.write(`  \x1b[32m✓\x1b[0m Profile 'work' created successfully\r\n\r\n`);
      term.write(prompt);
    };

    observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && isAutoDemo) {
        runAutoDemo();
        if (observer) observer.disconnect();
      }
    }, { threshold: 0.3 });
    observer.observe(container);

    // --- INTERACTIVE ENGINE ---

    term.onData(e => {
      if (isAutoDemo || !term) return; 
      
      // Ignore unhandled ANSI escape sequences (like Arrow Keys) to prevent garbage [C printing
      if (e.startsWith('\x1b')) return;

      switch (e) {
        case '\r': // Enter
          term.write('\r\n');
          handleCommand(currentLine);
          currentLine = '';
          break;
        case '\x7F': // Backspace
          if (currentLine.length > 0) {
            currentLine = currentLine.slice(0, -1);
            term.write('\b \b');
          }
          break;
        case '\x03': // Ctrl+C
          term.write('^C\r\n');
          currentLine = '';
          setupState = 'IDLE';
          clearInterval(processingInterval);
          term.write(prompt);
          break;
        default:
          if (e >= String.fromCharCode(32) && e <= String.fromCharCode(126)) {
            currentLine += e;
            term.write(e);
          }
      }
    });

    function handleCommand(cmd: string) {
      cmd = cmd.trim();
      if (!term) return;
      
      if (setupState === 'PROFILE') {
        profileName = cmd || 'work';
        term.write('  Git email: ');
        setupState = 'EMAIL';
        return;
      }
      if (setupState === 'EMAIL') {
        term.write('  Directory: ');
        setupState = 'DIRECTORY';
        return;
      }
      if (setupState === 'DIRECTORY') {
        term.write('\r\n');
        simulateProcessing(() => {
          if (!term) return;
          term.write(`  \x1b[32m✓\x1b[0m SSH key generated: ~/.ssh/id_ed25519_${profileName}\r\n`);
          term.write(`  \x1b[32m✓\x1b[0m Git config written: ~/.config/gitsetu/${profileName}.gitconfig\r\n`);
          term.write(`  \x1b[32m✓\x1b[0m SSH config updated: ~/.ssh/config\r\n`);
          term.write(`  \x1b[32m✓\x1b[0m Profile '${profileName}' created successfully\r\n\r\n`);
          
          const installCmd = document.getElementById('install-cmd');
          if (installCmd && navigator.clipboard) {
            navigator.clipboard.writeText(installCmd.textContent?.trim() || '');
            term.write('\x1b[35m✨ Install command copied to clipboard. Paste into your real terminal!\x1b[0m\r\n\r\n');
          }

          setupState = 'IDLE';
          term.write(prompt);
        });
        return;
      }

      if (cmd === '') {
        term.write(prompt);
      } else if (cmd === 'gitsetu setup') {
        setupState = 'PROFILE';
        term.write('  Profile name: ');
      } else if (cmd === 'gitsetu') {
        term.write('GitSetu Identity Orchestrator v1.1.0\r\n');
        term.write('Usage: gitsetu <command>\r\n\r\nCommands:\r\n  setup    Create a new identity profile\r\n  list     List active profiles\r\n');
        term.write(prompt);
      } else if (cmd === 'clear') {
        term.clear();
        term.write(prompt);
      } else if (cmd === 'ls') {
        term.write('\x1b[34mprojects\x1b[0m  \x1b[34mwork\x1b[0m  install.sh\r\n');
        term.write(prompt);
      } else {
        term.write(`bash: ${cmd}: command not found\r\n`);
        term.write(prompt);
      }
    }

    function simulateProcessing(callback: () => void) {
      if (!term) return;
      let dots = 0;
      term.write('  \x1b[36mGenerating cryptographic keys\x1b[0m');
      processingInterval = setInterval(() => {
        if (!term) return;
        term.write('.');
        dots++;
        if (dots >= 3) {
          clearInterval(processingInterval);
          term.write('\x1b[2K\r'); 
          callback();
        }
      }, 350);
    }
  });
</script>

<style>
  .terminal-window {
    width: 100%;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    position: relative;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
  }

  .traffic-lights {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .terminal-modes {
    position: absolute;
    right: 16px;
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,0.05);
    padding: 2px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .mode-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 10px;
    font-family: var(--font-sans);
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-btn:hover {
    color: var(--text-primary);
  }

  .mode-btn.active {
    background: rgba(255,255,255,0.1);
    color: var(--text-primary);
  }

  .terminal-body {
    padding: var(--space-md);
    background: transparent;
    cursor: text;
  }

  .terminal-hint {
    position: absolute;
    bottom: 16px;
    right: 16px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .terminal-window:focus-within .terminal-hint {
    opacity: 0;
  }

  /* Xterm CSS Overrides to match theme */
  :global(.xterm-viewport) {
    background-color: transparent !important;
  }
  
  :global(.xterm-screen) {
    padding-left: 8px;
  }
</style>
