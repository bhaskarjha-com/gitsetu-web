---
---

<div class="terminal-window" aria-label="Interactive Terminal showing GitSetu setup">
  <div class="terminal-header">
    <div class="traffic-lights">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
    </div>
    <span class="terminal-title">gitsetu — bash (Interactive)</span>
  </div>
  <div class="terminal-body" id="terminal-container" style="height: 340px; width: 100%;">
    <!-- Xterm.js will mount here -->
  </div>
  <div class="terminal-hint">
    Type <kbd>gitsetu setup</kbd> and hit Enter
  </div>
</div>

<script>
  import { Terminal } from 'xterm';
  import { FitAddon } from '@xterm/addon-fit';
  import 'xterm/css/xterm.css';

  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('terminal-container');
    if (!container) return;
    
    container.innerHTML = '';

    const term = new Terminal({
      cursorBlink: true,
      fontFamily: 'JetBrains Mono, monospace',
      fontSize: 13,
      theme: {
        background: 'transparent',
        foreground: '#d4d4d8',
        cursor: '#00e5ff',
        black: '#000000',
        red: '#ff5f56',
        green: '#27c93f',
        yellow: '#ffbd2e',
        blue: '#00e5ff',
        magenta: '#ff79c6',
        cyan: '#8be9fd',
        white: '#bfbfbf'
      },
      allowTransparency: true,
      disableStdin: false
    });

    const fitAddon = new FitAddon();
    term.loadAddon(fitAddon);
    term.open(container);
    
    // Fit to container dimensions after a brief DOM paint delay
    setTimeout(() => {
      try { fitAddon.fit(); } catch (e) {}
    }, 100);

    // Responsive resize
    window.addEventListener('resize', () => {
      try { fitAddon.fit(); } catch (e) {}
    });

    const prompt = '\x1b[1;32m~\x1b[0m \x1b[1;36m❯\x1b[0m ';
    term.write(prompt);

    let currentLine = '';
    let setupState = 'IDLE'; // IDLE, PROFILE, EMAIL, DIRECTORY
    let profileName = '';

    term.onData(e => {
      switch (e) {
        case '\r': // Enter
          term.write('\r\n');
          handleCommand(currentLine);
          currentLine = '';
          break;
        case '\x7F': // Backspace
          if (currentLine.length > 0) {
            currentLine = currentLine.slice(0, -1);
            term.write('\b \b');
          }
          break;
        default:
          // Filter printable characters
          if (e >= String.fromCharCode(32) && e <= String.fromCharCode(126)) {
            currentLine += e;
            term.write(e);
          }
      }
    });

    function handleCommand(cmd: string) {
      cmd = cmd.trim();
      
      if (setupState === 'PROFILE') {
        profileName = cmd || 'work';
        term.write('  Git email: ');
        setupState = 'EMAIL';
        return;
      }
      if (setupState === 'EMAIL') {
        term.write('  Directory: ');
        setupState = 'DIRECTORY';
        return;
      }
      if (setupState === 'DIRECTORY') {
        term.write('\r\n');
        simulateProcessing(() => {
          term.write(`  \x1b[32m✓\x1b[0m SSH key generated: ~/.ssh/id_ed25519_${profileName}\r\n`);
          term.write(`  \x1b[32m✓\x1b[0m Git config written: ~/.config/gitsetu/${profileName}.gitconfig\r\n`);
          term.write(`  \x1b[32m✓\x1b[0m SSH config updated: ~/.ssh/config\r\n`);
          term.write(`  \x1b[32m✓\x1b[0m Profile '${profileName}' created successfully\r\n\r\n`);
          setupState = 'IDLE';
          term.write(prompt);
          
          // Easter egg: auto-copy the real installation command after demo success
          setTimeout(() => {
            const installCmd = document.getElementById('install-cmd');
            if (installCmd && navigator.clipboard) {
              navigator.clipboard.writeText(installCmd.textContent?.trim() || '');
            }
          }, 500);
        });
        return;
      }

      // Normal command parsing
      if (cmd === '') {
        term.write(prompt);
      } else if (cmd === 'gitsetu setup') {
        setupState = 'PROFILE';
        term.write('  Profile name: ');
      } else if (cmd === 'gitsetu') {
        term.write('GitSetu Identity Orchestrator v1.1.0\r\n');
        term.write('Usage: gitsetu <command>\r\n\r\nCommands:\r\n  setup    Create a new identity profile\r\n  list     List active profiles\r\n');
        term.write(prompt);
      } else if (cmd === 'clear') {
        term.clear();
        term.write(prompt);
      } else if (cmd === 'ls') {
        term.write('\x1b[34mprojects\x1b[0m  \x1b[34mwork\x1b[0m  install.sh\r\n');
        term.write(prompt);
      } else {
        term.write(`bash: ${cmd}: command not found\r\n`);
        term.write(prompt);
      }
    }

    function simulateProcessing(callback: () => void) {
      let dots = 0;
      term.write('  \x1b[36mGenerating cryptographic keys\x1b[0m');
      const interval = setInterval(() => {
        term.write('.');
        dots++;
        if (dots >= 3) {
          clearInterval(interval);
          term.write('\x1b[2K\r'); // Erase line and return carriage
          callback();
        }
      }, 350);
    }
  });
</script>

<style>
  .terminal-window {
    width: 100%;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    position: relative;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
  }

  .traffic-lights {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .terminal-body {
    padding: var(--space-md);
    background: transparent;
    cursor: text;
  }

  .terminal-hint {
    position: absolute;
    bottom: 16px;
    right: 16px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .terminal-window:focus-within .terminal-hint {
    opacity: 0;
  }

  /* Xterm CSS Overrides to match theme */
  :global(.xterm-viewport) {
    background-color: transparent !important;
  }
  
  :global(.xterm-screen) {
    padding-left: 8px;
  }
</style>
