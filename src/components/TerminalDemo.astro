---
---

<section class="terminal-section section" aria-label="Terminal demo showing GitSetu setup">
  <div class="container">
    <div class="terminal-window">
      <div class="terminal-header">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">gitsetu — bash</span>
      </div>
      <div class="terminal-body" id="terminal-demo">
        <div class="terminal-line">
          <span class="prompt">$</span>
          <span class="command" data-delay="0">gitsetu setup</span>
        </div>
        <div class="terminal-line output" data-delay="600">
          <span>  Profile name: <span class="highlight">work</span></span>
        </div>
        <div class="terminal-line output" data-delay="900">
          <span>  Git email: <span class="highlight">dev@company.com</span></span>
        </div>
        <div class="terminal-line output" data-delay="1200">
          <span>  Directory: <span class="highlight">~/work</span></span>
        </div>
        <div class="terminal-line output" data-delay="1600">
          <span class="success">  ✓ SSH key generated: ~/.ssh/id_ed25519_work</span>
        </div>
        <div class="terminal-line output" data-delay="1900">
          <span class="success">  ✓ Git config written: ~/.config/gitsetu/work.gitconfig</span>
        </div>
        <div class="terminal-line output" data-delay="2200">
          <span class="success">  ✓ SSH config updated: ~/.ssh/config</span>
        </div>
        <div class="terminal-line output" data-delay="2500">
          <span class="success">  ✓ Profile 'work' created successfully</span>
        </div>

        <div class="terminal-line" data-delay="3200">
          <span class="prompt">$</span>
          <span class="command">gitsetu status</span>
        </div>
        <div class="terminal-line output" data-delay="3700">
          <span>  <span class="highlight">work</span>       dev@company.com    ~/work      <span class="success">✓ active</span></span>
        </div>
        <div class="terminal-line output" data-delay="4000">
          <span>  <span class="highlight">personal</span>   me@gmail.com       ~/personal</span>
        </div>

        <div class="terminal-line" data-delay="4800">
          <span class="prompt">$</span>
          <span class="command">cd ~/work/my-api && git commit -m "fix: auth bug"</span>
        </div>
        <div class="terminal-line output" data-delay="5300">
          <span>  Author: Aditya Kumar &lt;dev@company.com&gt; <span class="accent">← correct, automatically</span></span>
        </div>
      </div>
    </div>

    <p class="terminal-caption">
      One-time setup. Then just <code>cd</code> and work.<br />
      Git does the rest — powered by native <code>includeIf</code>.
    </p>
  </div>
</section>

<script>
  // Progressive reveal animation (IntersectionObserver-based)
  const terminal = document.getElementById('terminal-demo');
  if (terminal) {
    const lines = terminal.querySelectorAll('.terminal-line');
    lines.forEach(line => {
      (line as HTMLElement).style.opacity = '0';
      (line as HTMLElement).style.transform = 'translateY(4px)';
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            lines.forEach((line) => {
              const delay = parseInt((line as HTMLElement).dataset.delay || '0', 10);
              setTimeout(() => {
                (line as HTMLElement).style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                (line as HTMLElement).style.opacity = '1';
                (line as HTMLElement).style.transform = 'translateY(0)';
              }, delay);
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(terminal);
  }
</script>

<style>
  .terminal-section {
    background: var(--bg-primary);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-4xl);
  }

  .terminal-window {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 80px rgba(0, 196, 204, 0.1);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    margin-left: 8px;
  }

  .terminal-body {
    padding: var(--space-lg) var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.8;
    min-height: 340px;
    overflow-x: auto;
  }

  .terminal-line {
    white-space: pre-wrap;
    word-break: break-all;
  }

  .terminal-line + .terminal-line:not(.output) {
    margin-top: var(--space-lg);
  }

  .prompt {
    color: var(--accent-primary);
    margin-right: 8px;
    user-select: none;
  }

  .command {
    color: var(--text-heading);
    font-weight: 400;
  }

  .output {
    color: var(--text-secondary);
  }

  .success {
    color: var(--color-success);
  }

  .highlight {
    color: var(--accent-primary);
  }

  .accent {
    color: var(--accent-secondary);
    font-style: italic;
  }

  .terminal-caption {
    text-align: center;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-top: var(--space-2xl);
    line-height: 1.8;
  }

  .terminal-caption code {
    background: var(--bg-tertiary);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    color: var(--accent-primary);
  }

  @media (max-width: 768px) {
    .terminal-body {
      padding: var(--space-md);
      font-size: var(--text-xs);
      min-height: 280px;
    }
  }
</style>
