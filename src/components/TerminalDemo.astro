---
---

<gitsetu-terminal>
  <div class="terminal-window" aria-label="Interactive Terminal showing GitSetu setup">
    <div class="terminal-header">
      <div class="traffic-lights">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
      </div>
      <span class="terminal-title">gitsetu — bash</span>
      
      <div class="terminal-modes">
        <button class="mode-btn active" id="mode-demo">Auto-Demo</button>
        <button class="mode-btn" id="mode-interactive">Interactive</button>
      </div>
    </div>
    
    <div class="terminal-body">
      <div id="terminal-container" style="height: 340px; width: 100%; position: relative;">
        <!-- Xterm.js will mount here -->
      </div>
    </div>
    
    <div class="terminal-hint" id="terminal-hint">
      Click terminal to take control
    </div>
  </div>
</gitsetu-terminal>

<script>
  import { Terminal } from '@xterm/xterm';
  import '@xterm/xterm/css/xterm.css';

  class GitsetuTerminal extends HTMLElement {
    term: Terminal | null = null;
    demoTimeout: any = null;
    processingInterval: any = null;
    visibilityObserver: IntersectionObserver | null = null;
    
    isAutoDemo = true;
    isDemoRunning = false;
    setupState = 'IDLE';
    currentLine = '';
    profileName = '';
    
    prompt = '\x1b[1;32m~\x1b[0m \x1b[1;36m❯\x1b[0m ';

    connectedCallback() {
      // Small delay to allow Astro View Transitions to inject the element safely
      setTimeout(() => this.initTerminal(), 100);
    }

    disconnectedCallback() {
      this.cleanup();
    }

    cleanup() {
      this.isAutoDemo = true;
      this.isDemoRunning = false;
      this.setupState = 'IDLE';
      this.currentLine = '';
      this.profileName = '';
      
      if (this.demoTimeout) clearTimeout(this.demoTimeout);
      if (this.processingInterval) clearInterval(this.processingInterval);
      if (this.visibilityObserver) {
        this.visibilityObserver.disconnect();
        this.visibilityObserver = null;
      }
      if (this.term) {
        this.term.dispose();
        this.term = null;
      }
    }

    async initTerminal() {
      const container = this.querySelector('#terminal-container') as HTMLElement;
      const demoBtn = this.querySelector('#mode-demo') as HTMLElement;
      const interactiveBtn = this.querySelector('#mode-interactive') as HTMLElement;
      const hint = this.querySelector('#terminal-hint') as HTMLElement;
      
      if (!container) return;
      
      this.cleanup();
      container.innerHTML = '';

      this.term = new Terminal({
        cols: 70, // Fixed safe column count that fits the 600px container perfectly
        rows: 15,
        cursorBlink: true,
        fontFamily: 'monospace', // Start with fallback to prevent early texture corruption
        fontSize: 13,
        theme: {
          background: 'transparent',
          foreground: '#d4d4d8',
          cursor: '#00e5ff',
          black: '#000000',
          red: '#ff5f56',
          green: '#27c93f',
          yellow: '#ffbd2e',
          blue: '#00e5ff',
          magenta: '#ff79c6',
          cyan: '#8be9fd',
          white: '#bfbfbf'
        },
        allowTransparency: true,
        disableStdin: false
      });

      this.term.open(container);
      this.term.reset(); // Hard flush WebGL state
      this.term.clearTextureAtlas();

      // Dynamically upgrade font once loaded
      document.fonts.load('13px "JetBrains Mono"').then(() => {
        if (this.term) {
          this.term.options.fontFamily = '"JetBrains Mono", monospace';
          this.term.clearTextureAtlas();
        }
      }).catch(() => {});

      // Start Auto Demo automatically via IntersectionObserver
      let hasTriggered = false;
      this.visibilityObserver = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting && this.isAutoDemo && !hasTriggered) {
          hasTriggered = true;
          this.runAutoDemo();
          if (this.visibilityObserver) this.visibilityObserver.disconnect();
        }
      }, { threshold: 0.1 });
      this.visibilityObserver.observe(container);

      // --- HYBRID LOGIC ---

      demoBtn?.addEventListener('click', () => {
        if (this.isAutoDemo) return;
        this.isAutoDemo = true;
        this.isDemoRunning = false; // Reset lock
        
        demoBtn.classList.add('active');
        interactiveBtn.classList.remove('active');
        hint.style.opacity = '1';
        
        if (this.term) {
          this.term.reset();
          this.term.clearTextureAtlas();
        }
        
        this.setupState = 'IDLE';
        this.currentLine = '';
        this.profileName = '';
        
        if (this.demoTimeout) clearTimeout(this.demoTimeout);
        if (this.processingInterval) clearInterval(this.processingInterval);
        
        this.runAutoDemo();
      });

      interactiveBtn?.addEventListener('click', () => {
        if (!this.isAutoDemo) return;
        this.isAutoDemo = false; // The loops will check this and naturally exit!
        
        demoBtn.classList.remove('active');
        interactiveBtn.classList.add('active');
        hint.style.opacity = '0';
        
        // DO NOT clear demoTimeout! Let the async loop naturally detect isAutoDemo=false and terminate itself!
        // This prevents the dead-promise hang bug when returning to Auto-Demo.
        if (this.processingInterval) clearInterval(this.processingInterval);
        
        if (this.term) {
          this.term.reset();
          this.term.clearTextureAtlas();
          this.term.write('\x1b[3mSandbox active. Try typing \x1b[33mgitsetu setup\x1b[0m\x1b[3m.\x1b[0m\r\n\r\n');
          this.term.write(this.prompt);
        }
      });

      container.addEventListener('click', () => {
        if (this.isAutoDemo) {
          interactiveBtn?.click();
        }
        if (this.term) this.term.focus();
      });

      // --- INTERACTIVE ENGINE ---

      this.term.onData(e => {
        if (this.isAutoDemo || !this.term) return; 

        if (e === '\x1b[A' || e === '\x1b[B' || e === '\x1b[C' || e === '\x1b[D') return;

        switch (e) {
          case '\r': // Enter
            this.term.write('\r\n');
            this.handleCommand(this.currentLine.trim());
            this.currentLine = '';
            break;
          case '\x7F': // Backspace
            if (this.currentLine.length > 0) {
              this.currentLine = this.currentLine.substring(0, this.currentLine.length - 1);
              this.term.write('\b \b');
            }
            break;
          case '\x03': // Ctrl+C
            this.term.write('^C\r\n');
            this.currentLine = '';
            this.setupState = 'IDLE';
            clearInterval(this.processingInterval);
            this.term.write(this.prompt);
            break;
          default:
            if (e >= String.fromCharCode(32) && e <= String.fromCharCode(126)) {
              this.currentLine += e;
              this.term.write(e);
            }
        }
      });
    }

    async wait(ms: number) {
      await new Promise(r => { this.demoTimeout = setTimeout(r, ms) });
    }

    async typeText(text: string, speed = 45) {
      for (let i = 0; i < text.length; i++) {
        if (!this.isAutoDemo || !this.term) {
          this.isDemoRunning = false; // Reset lock if interrupted
          return false;
        }
        this.term.write(text.charAt(i));
        await this.wait(speed);
      }
      return true;
    }

    simulateProcessing(callback: () => void) {
      if (!this.term) return;
      let dots = 0;
      this.term.write('  \x1b[36mGenerating cryptographic keys\x1b[0m');
      this.processingInterval = setInterval(() => {
        if (!this.term) return;
        this.term.write('.');
        dots++;
        if (dots >= 3) {
          clearInterval(this.processingInterval);
          this.term.write('\x1b[2K\r'); 
          callback();
        }
      }, 350);
    }

    handleCommand(cmd: string) {
      if (!this.term) return;
      if (this.setupState === 'IDLE') {
        if (cmd === 'gitsetu setup') {
          this.term.write('  Profile name: ');
          this.setupState = 'PROFILE_NAME';
        } else if (cmd === 'clear') {
          this.term.reset();
          this.term.write(this.prompt);
        } else if (cmd !== '') {
          this.term.write(`\x1b[31mbash: command not found:\x1b[0m ${cmd}\r\n${this.prompt}`);
        } else {
          this.term.write(this.prompt);
        }
      } else if (this.setupState === 'PROFILE_NAME') {
        this.profileName = cmd || 'work';
        this.term.write(`  Git email: `);
        this.setupState = 'GIT_EMAIL';
      } else if (this.setupState === 'GIT_EMAIL') {
        this.term.write(`  Directory: `);
        this.setupState = 'DIRECTORY';
      } else if (this.setupState === 'DIRECTORY') {
        this.setupState = 'PROCESSING';
        this.simulateProcessing(() => {
          if (!this.term) return;
          this.term.write(`  \x1b[32m✔\x1b[0m SSH key generated: \x1b[33m~/.ssh/id_ed25519_${this.profileName}\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Git config written: \x1b[33m~/.config/gitsetu/${this.profileName}.gitconfig\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m SSH config updated: \x1b[33m~/.ssh/config\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Profile '${this.profileName}' created successfully\r\n\r\n`);
          this.term.write(this.prompt);
          this.setupState = 'IDLE';
        });
      }
    }

    async runAutoDemo() {
      if (this.isDemoRunning || !this.isAutoDemo || !this.term) return;
      this.isDemoRunning = true;
      this.term.write(this.prompt);
      
      await this.wait(1000);
      
      if (!(await this.typeText('gitsetu setup', 60))) return;
      
      await this.wait(400);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  Profile name: ');
      
      await this.wait(600);
      if (!(await this.typeText('work', 80))) return;
      
      await this.wait(400);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  Git email: ');
      
      await this.wait(500);
      if (!(await this.typeText('dev@company.com', 50))) return;
      
      await this.wait(400);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  Directory: ');
      
      await this.wait(500);
      if (!(await this.typeText('~/work', 70))) return;
      
      await this.wait(500);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  \x1b[36mGenerating cryptographic keys\x1b[0m');
      
      for(let i = 0; i < 3; i++) {
        await this.wait(400);
        if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
        this.term.write('.');
      }
      
      await this.wait(200);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      this.term.write('\x1b[2K\r'); // Erase line
      
      this.term.write('  \x1b[32m✔\x1b[0m SSH key generated: \x1b[33m~/.ssh/id_ed25519_work\x1b[0m\r\n');
      await this.wait(200);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      
      this.term.write('  \x1b[32m✔\x1b[0m Git config written: \x1b[33m~/.config/gitsetu/work.gitconfig\x1b[0m\r\n');
      await this.wait(200);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      
      this.term.write('  \x1b[32m✔\x1b[0m SSH config updated: \x1b[33m~/.ssh/config\x1b[0m\r\n');
      await this.wait(200);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      
      this.term.write('  \x1b[32m✔\x1b[0m Profile \'work\' created successfully\r\n\r\n');
      await this.wait(500);
      if(!this.isAutoDemo || !this.term) { this.isDemoRunning = false; return; }
      
      this.term.write(this.prompt);
      this.isDemoRunning = false;
    }
  }

  // Register the custom element once
  if (typeof window !== 'undefined' && !customElements.get('gitsetu-terminal')) {
    customElements.define('gitsetu-terminal', GitsetuTerminal);
  }
</script>

<style>
  .terminal-window {
    width: 100%;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    position: relative;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
  }

  .traffic-lights {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27c93f; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .terminal-modes {
    position: absolute;
    right: 16px;
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,0.05);
    padding: 2px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .mode-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 10px;
    font-family: var(--font-sans);
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-btn:hover {
    color: var(--text-primary);
  }

  .mode-btn.active {
    background: rgba(255,255,255,0.1);
    color: var(--text-primary);
  }

  .terminal-body {
    padding: var(--space-md);
    background: transparent;
    cursor: text;
  }

  .terminal-hint {
    position: absolute;
    bottom: 16px;
    right: 16px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .terminal-window:focus-within .terminal-hint {
    opacity: 0;
  }

  /* Xterm CSS Overrides to match theme */
  :global(.xterm-viewport) {
    background-color: transparent !important;
  }
  
  :global(.xterm-screen) {
    padding-left: 8px;
  }
</style>
