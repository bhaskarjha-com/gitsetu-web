---
---

<div id="command-palette-backdrop" class="cmd-backdrop" aria-hidden="true">
  <div class="cmd-modal" role="dialog" aria-modal="true" aria-label="Command Palette">
    <div class="cmd-header">
      <svg class="cmd-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="cmd-input" class="cmd-input" placeholder="Search documentation, commands, and settings..." autocomplete="off" spellcheck="false" />
      <button id="cmd-close" class="cmd-close" aria-label="Close">ESC</button>
    </div>
    <div class="cmd-body">
      <div class="cmd-section">
        <div class="cmd-section-title">Quick Links</div>
        <ul class="cmd-results">
          <li>
            <a href="/docs/getting-started/quickstart" class="cmd-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              <span>Quickstart Guide</span>
              <kbd class="cmd-shortcut">⏎</kbd>
            </a>
          </li>
          <li>
            <a href="/docs/core-concepts/identity-routing" class="cmd-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
              <span>Identity Routing Architecture</span>
            </a>
          </li>
          <li>
            <a href="/docs/guides/hardware-keys-fido2" class="cmd-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
              <span>Configure FIDO2 Hardware Keys</span>
            </a>
          </li>
        </ul>
      </div>
      
      <div class="cmd-section">
        <div class="cmd-section-title">Actions</div>
        <ul class="cmd-results">
          <li>
            <button class="cmd-item" onclick="navigator.clipboard.writeText('curl -sL https://gitsetu.com/install | bash'); alert('Install command copied!')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Install Command</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
    <div class="cmd-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>⏎</kbd> to select</span>
      <span><kbd>ESC</kbd> to close</span>
    </div>
  </div>
</div>

<script>
  const backdrop = document.getElementById('command-palette-backdrop');
  const input = document.getElementById('cmd-input');
  const closeBtn = document.getElementById('cmd-close');
  
  function openPalette() {
    backdrop?.classList.add('active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 100);
  }

  function closePalette() {
    backdrop?.classList.remove('active');
    document.body.style.overflow = '';
    input?.blur();
  }

  // Listen for custom event from Navbar or anywhere else
  document.addEventListener('open-command-palette', openPalette);

  // Close when clicking the backdrop
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closePalette();
  });

  // Close via button
  closeBtn?.addEventListener('click', closePalette);

  // Global Keydown
  document.addEventListener('keydown', (e) => {
    // Escape to close
    if (e.key === 'Escape' && backdrop?.classList.contains('active')) {
      closePalette();
    }
  });
</script>

<style>
  .cmd-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .cmd-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .cmd-modal {
    width: 100%;
    max-width: 600px;
    background: rgba(10, 10, 10, 0.95);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transform: scale(0.98) translateY(-10px);
    transition: transform var(--transition-fast);
  }

  .cmd-backdrop.active .cmd-modal {
    transform: scale(1) translateY(0);
  }

  .cmd-header {
    display: flex;
    align-items: center;
    padding: 0 var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.02);
  }

  .cmd-search-icon {
    color: var(--accent-primary);
    margin-right: var(--space-sm);
  }

  .cmd-input {
    flex-grow: 1;
    background: transparent;
    border: none;
    color: var(--text-heading);
    font-size: var(--text-lg);
    padding: var(--space-lg) 0;
    outline: none;
    font-family: var(--font-sans);
  }

  .cmd-input::placeholder {
    color: var(--text-muted);
  }

  .cmd-close {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cmd-close:hover {
    color: var(--text-heading);
    border-color: var(--text-secondary);
  }

  .cmd-body {
    padding: var(--space-md) var(--space-lg);
    max-height: 400px;
    overflow-y: auto;
  }

  .cmd-section {
    margin-bottom: var(--space-lg);
  }

  .cmd-section:last-child {
    margin-bottom: 0;
  }

  .cmd-section-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .cmd-results {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 12px 16px;
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: left;
    margin-bottom: 4px;
    gap: 12px;
  }

  .cmd-item:hover, .cmd-item:focus {
    background: rgba(0, 229, 255, 0.05);
    color: var(--text-heading);
    outline: none;
  }

  .cmd-item svg {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .cmd-item:hover svg, .cmd-item:focus svg {
    color: var(--accent-primary);
  }

  .cmd-shortcut {
    margin-left: auto;
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid var(--border-subtle);
    font-size: 11px;
    color: var(--text-muted);
  }

  .cmd-footer kbd {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    padding: 2px 4px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  @media (max-width: 600px) {
    .cmd-backdrop {
      padding-top: 0;
    }
    .cmd-modal {
      height: 100%;
      border-radius: 0;
      border: none;
    }
    .cmd-body {
      max-height: calc(100vh - 140px);
    }
  }
</style>
