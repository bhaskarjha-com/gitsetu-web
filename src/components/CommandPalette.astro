---
---

<div id="command-palette-backdrop" class="cmd-backdrop" aria-hidden="true">
  <div class="cmd-modal" role="dialog" aria-modal="true" aria-label="Command Palette">
    <div class="cmd-header">
      <svg class="cmd-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="cmd-input" class="cmd-input" placeholder="Search documentation, commands, and settings..." autocomplete="off" spellcheck="false" />
      <button id="cmd-close" class="cmd-close" aria-label="Close">ESC</button>
    </div>
    <div class="cmd-body">
      <!-- Dynamic Search Results -->
      <div class="cmd-section" id="dynamic-search-section" style="display: none;">
        <ul class="cmd-results" id="dynamic-search-results">
          <!-- Injected via JS -->
        </ul>
      </div>

      <div class="cmd-section default-section">
        <div class="cmd-section-title">Quick Links</div>
        <ul class="cmd-results">
          <li>
            <a href="/docs/getting-started/quickstart" class="cmd-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              <span>Quickstart Guide</span>
              <kbd class="cmd-shortcut">⏎</kbd>
            </a>
          </li>
          <li>
            <a href="/docs/core-engines/identity-routing" class="cmd-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
              <span>Identity Routing Architecture</span>
            </a>
          </li>
          <li>
            <a href="/docs/guides/hardware-keys" class="cmd-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
              <span>Configure FIDO2 Hardware Keys</span>
            </a>
          </li>
        </ul>
      </div>
      
      <div class="cmd-section default-section">
        <div class="cmd-section-title">Actions</div>
        <ul class="cmd-results">
          <li>
            <button class="cmd-item" onclick="navigator.clipboard.writeText('curl -sL https://gitsetu.bhaskarjha.dev/install | bash'); alert('Install command copied!')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Install Command</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
    <div class="cmd-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>⏎</kbd> to select</span>
      <span><kbd>ESC</kbd> to close</span>
    </div>
  </div>
</div>

<script>
  // Setup the Command Palette on every page navigation
  document.addEventListener('astro:page-load', () => {
    const backdrop = document.getElementById('command-palette-backdrop');
    const input = document.getElementById('cmd-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('cmd-close');
    const defaultSections = document.querySelectorAll('.default-section');
    const dynamicSection = document.getElementById('dynamic-search-section');
    const dynamicResults = document.getElementById('dynamic-search-results');
    
    let searchIndex: Array<{title: string, description: string, url: string, content: string}> = [];
    let isFetching = false;
    let selectedIndex = -1;

    function updateSelection() {
      const items = dynamicSection?.style.display === 'none' 
        ? Array.from(document.querySelectorAll('.default-section:not([style*="display: none"]) li:not([style*="display: none"]) .cmd-item'))
        : Array.from(document.querySelectorAll('#dynamic-search-results .cmd-item'));
      
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          (item as HTMLElement).focus();
          (item as HTMLElement).classList.add('selected');
        } else {
          (item as HTMLElement).classList.remove('selected');
        }
      });
    }

    async function fetchSearchIndex() {
      if (searchIndex.length > 0 || isFetching) return;
      isFetching = true;
      try {
        const res = await fetch('/search.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        searchIndex = data;
      } catch (e: any) {
        console.error('Failed to fetch search index:', e);
        if (dynamicResults) {
          dynamicResults.innerHTML = `
            <li style="padding: 12px 16px; color: #ff5f56; font-size: 12px;">
              Failed to load search index: ${e.message}
            </li>
          `;
        }
      }
    }

    function openPalette() {
      fetchSearchIndex();
      backdrop?.classList.add('active');
      document.body.style.overflow = 'hidden';
      selectedIndex = -1;
      setTimeout(() => {
        if (input) {
          input.value = '';
          input.dispatchEvent(new Event('input'));
          input.focus();
        }
      }, 100);
    }

    function closePalette() {
      backdrop?.classList.remove('active');
      document.body.style.overflow = '';
      selectedIndex = -1;
      input?.blur();
    }

    // Live Search Filtering
    input?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      
      if (query.length > 0) {
        defaultSections.forEach(sec => (sec as HTMLElement).style.display = 'none');
        
        if (dynamicSection && dynamicResults) {
          dynamicSection.style.display = '';
          
          const titleMatches: Array<any> = [];
          const contentMatches: Array<any> = [];
          const commandMatches: Array<string> = [];

          searchIndex.forEach(item => {
            const inTitle = item.title.toLowerCase().includes(query) || 
                            item.description.toLowerCase().includes(query) ||
                            item.url.toLowerCase().includes(query);
                            
            if (inTitle) {
              titleMatches.push(item);
            } else if (item.content && item.content.toLowerCase().includes(query)) {
              contentMatches.push(item);
            }
          });

          defaultSections.forEach(sec => {
            const items = sec.querySelectorAll('.cmd-item');
            items.forEach(item => {
              if (item.textContent?.toLowerCase().includes(query)) {
                commandMatches.push(item.parentElement?.innerHTML || '');
              }
            });
          });

          let html = '';

          if (titleMatches.length > 0) {
            html += '<div class="cmd-section-title" style="margin-top: 12px;">Documentation</div>';
            html += titleMatches.map(item => `
              <li>
                <a href="${item.url}" class="cmd-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span>${item.title}</span>
                    ${item.description ? `<span style="font-size: 10px; opacity: 0.6;">${item.description}</span>` : ''}
                  </div>
                </a>
              </li>
            `).join('');
          }

          if (commandMatches.length > 0) {
            html += '<div class="cmd-section-title" style="margin-top: 12px;">Commands</div>';
            html += commandMatches.map(cmdHtml => `<li>${cmdHtml}</li>`).join('');
          }

          if (contentMatches.length > 0) {
            html += '<div class="cmd-section-title" style="margin-top: 12px;">Text Mentions</div>';
            html += contentMatches.map(item => `
              <li>
                <a href="${item.url}" class="cmd-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span>${item.title}</span>
                    <span style="font-size: 10px; opacity: 0.6; color: var(--accent-primary);">Match found in contents</span>
                  </div>
                </a>
              </li>
            `).join('');
          }

          if (html === '') {
            html = \`
              <li style="padding: 12px 16px; color: var(--text-muted); font-size: 12px;">
                No results found for "\${query}".
              </li>
            \`;
          }

          dynamicResults.innerHTML = html;
        }
      } else {
        defaultSections.forEach(sec => (sec as HTMLElement).style.display = '');
        if (dynamicSection) dynamicSection.style.display = 'none';
        
        defaultSections.forEach(section => {
          const items = section.querySelectorAll('.cmd-item');
          let hasVisibleItem = false;
          
          items.forEach(item => {
            const text = item.textContent?.toLowerCase() || '';
            const li = item.closest('li');
            if (text.includes(query)) {
              if (li) li.style.display = '';
              hasVisibleItem = true;
            } else {
              if (li) li.style.display = 'none';
            }
          });
          
          (section as HTMLElement).style.display = hasVisibleItem ? '' : 'none';
        });
      }
    });

    // Remove existing listener to prevent duplicates
    document.removeEventListener('open-command-palette', openPalette);
    document.addEventListener('open-command-palette', openPalette);

    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closePalette();
    });

    closeBtn?.addEventListener('click', closePalette);

    // Global Keydown for Navigation (Needs to be cleaned up or run once)
    const keydownHandler = (e: KeyboardEvent) => {
      if (!backdrop?.classList.contains('active')) return;
      
      if (e.key === 'Escape') {
        closePalette();
        return;
      }

      const items = dynamicSection?.style.display === 'none' 
        ? Array.from(document.querySelectorAll('.default-section:not([style*="display: none"]) li:not([style*="display: none"]) .cmd-item'))
        : Array.from(document.querySelectorAll('#dynamic-search-results .cmd-item'));

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length > 0) {
          selectedIndex = (selectedIndex + 1) % items.length;
          updateSelection();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length > 0) {
          selectedIndex = (selectedIndex - 1 + items.length) % items.length;
          updateSelection();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && selectedIndex < items.length) {
          (items[selectedIndex] as HTMLElement).click();
        } else if (items.length > 0) {
          (items[0] as HTMLElement).click();
        }
      }
    };
    
    document.removeEventListener('keydown', keydownHandler);
    document.addEventListener('keydown', keydownHandler);
  });
</script>

<style is:global>
  .cmd-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .cmd-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .cmd-modal {
    width: 100%;
    max-width: 600px;
    background: rgba(10, 10, 10, 0.95);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transform: scale(0.98) translateY(-10px);
    transition: transform var(--transition-fast);
  }

  .cmd-backdrop.active .cmd-modal {
    transform: scale(1) translateY(0);
  }

  .cmd-header {
    display: flex;
    align-items: center;
    padding: 0 var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.02);
  }

  .cmd-search-icon {
    color: var(--accent-primary);
    margin-right: var(--space-sm);
  }

  .cmd-input {
    flex-grow: 1;
    background: transparent;
    border: none;
    color: var(--text-heading);
    font-size: var(--text-lg);
    padding: var(--space-lg) 0;
    outline: none;
    font-family: var(--font-sans);
  }

  .cmd-input::placeholder {
    color: var(--text-muted);
  }

  .cmd-close {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .cmd-close:hover {
    color: var(--text-heading);
    border-color: var(--text-secondary);
  }

  .cmd-body {
    padding: var(--space-md) var(--space-lg);
    max-height: 400px;
    overflow-y: auto;
  }

  .cmd-section {
    margin-bottom: var(--space-lg);
  }

  .cmd-section:last-child {
    margin-bottom: 0;
  }

  .cmd-section-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .cmd-results {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 12px 16px;
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: left;
    margin-bottom: 4px;
    gap: 12px;
  }

  .cmd-item:hover, .cmd-item:focus, .cmd-item.selected {
    background: rgba(0, 229, 255, 0.05);
    color: var(--text-heading);
    outline: none;
  }

  .cmd-item svg {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .cmd-item:hover svg, .cmd-item:focus svg {
    color: var(--accent-primary);
  }

  .cmd-shortcut {
    margin-left: auto;
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid var(--border-subtle);
    font-size: 11px;
    color: var(--text-muted);
  }

  .cmd-footer kbd {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    padding: 2px 4px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  @media (max-width: 600px) {
    .cmd-backdrop {
      padding-top: 0;
    }
    .cmd-modal {
      height: 100%;
      border-radius: 0;
      border: none;
    }
    .cmd-body {
      max-height: calc(100vh - 140px);
    }
  }
</style>
