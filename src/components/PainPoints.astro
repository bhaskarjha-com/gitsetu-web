---
const painPoints = [
  {
    icon: '❌',
    title: 'Wrong email in the commit log',
    problem: 'Pushed a freelance project with your work email. Now it\'s public. Can\'t rewrite history.',
    solution: 'Directory-scoped includeIf auto-switches identity'
  },
  {
    icon: '🔑',
    title: 'SSH key collisions',
    problem: 'One SSH key for three GitHub accounts. git push fails silently. You Google the same fix every month.',
    solution: 'Dedicated ED25519 keypair per profile, auto-wired'
  },
  {
    icon: '🔒',
    title: 'Port 22 blocked by corporate firewall',
    problem: 'HTTPS only. PATs get mixed between accounts. 403 errors on every second push.',
    solution: 'Per-profile credential broker via OS keychain'
  },
  {
    icon: '⚠️',
    title: 'Forgot to switch identity',
    problem: 'Committed 47 times before realizing you\'re using the wrong email. Too late now.',
    solution: 'Pre-commit guard blocks the commit before it happens'
  },
  {
    icon: '📝',
    title: 'Editing ~/.gitconfig by hand',
    problem: 'Edit, forget, break something, fix it, forget again. Every context switch is a liability.',
    solution: 'One-time setup, automatic forever'
  },
  {
    icon: '📦',
    title: 'Install Node just to manage Git?',
    problem: 'Every identity switcher needs Go, Node, Python, or a background daemon. A bootstrapper that needs a bootstrapper.',
    solution: 'Pure Bash 3.2. Zero dependencies. 10-second install.'
  }
];
---

<section class="pain-points section" id="why">
  <div class="container">
    <h2 class="section-title">
      Every developer with multiple accounts<br />
      <span class="accent-text">has these problems.</span>
    </h2>

    <div class="cards-grid">
      {painPoints.map((point) => (
        <div class="card">
          <span class="card-icon" aria-hidden="true">{point.icon}</span>
          <h3 class="card-title">{point.title}</h3>
          <p class="card-problem">{point.problem}</p>
          <p class="card-solution">→ {point.solution}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pain-points {
    background: var(--bg-secondary);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .card {
    background: var(--gradient-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
    border-color: var(--accent-primary);
  }

  .card-icon {
    font-size: var(--text-2xl);
    display: block;
    margin-bottom: var(--space-md);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--text-heading);
  }

  .card-problem {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .card-solution {
    font-size: var(--text-sm);
    color: var(--accent-primary);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
