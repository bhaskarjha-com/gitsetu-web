---
import TerminalDemo from './TerminalDemo.astro';
---

<section class="hero section reveal" id="install">
  <div class="container hero-inner">
    
    <div class="hero-content">
      <!-- Badge -->
      <div class="hero-badge reveal delay-100">
        <span class="badge-dot"></span>
        <span>v1.1.0 — Production Ready</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-title reveal delay-200">
        Never leak a <br/>
        <span class="accent-text">corporate commit</span> again.
      </h1>

      <!-- Subheadline -->
      <p class="hero-subtitle reveal delay-300">
        GitSetu is a zero-dependency pipeline that automatically routes your SSH keys and Git credentials based on your directory using a Zero-Trust architecture. 
        <br/><br/>
        One setup. Automatic forever.
      </p>

      <!-- CTA & Command -->
      <div class="hero-actions reveal delay-300">
        <div class="install-block">
          <code class="install-command" id="install-cmd">curl -sL https://raw.githubusercontent.com/bhaskarjha-com/gitsetu/main/install.sh | bash</code>
          <button class="copy-btn" id="copy-btn" aria-label="Copy install command" type="button">
            <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>
        <a href="/docs/getting-started/quickstart" class="btn btn-primary">Read the Docs</a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust reveal delay-300">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          168/168 Tests Passing
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Zero Telemetry
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          100% Native Bash 3.2
        </div>
      </div>
    </div>

    <!-- Product As Demo -->
    <div class="hero-visual reveal delay-200">
      <div class="terminal-glow"></div>
      <TerminalDemo />
    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const installCmd = document.getElementById('install-cmd');
  const copyIcon = copyBtn?.querySelector('.copy-icon');
  const checkIcon = copyBtn?.querySelector('.check-icon');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(installCmd?.textContent?.trim() || '');
      if (copyIcon) copyIcon.style.display = 'none';
      if (checkIcon) checkIcon.style.display = 'block';
      setTimeout(() => {
        if (copyIcon) copyIcon.style.display = 'block';
        if (checkIcon) checkIcon.style.display = 'none';
      }, 2000);
    } catch {
      const range = document.createRange();
      if (installCmd) range.selectNodeContents(installCmd);
      window.getSelection()?.removeAllRanges();
      window.getSelection()?.addRange(range);
    }
  });
</script>

<style>
  .hero {
    padding-top: calc(var(--nav-height) + var(--space-5xl));
    padding-bottom: var(--space-5xl);
    position: relative;
    overflow-x: clip; /* Prevent glow from causing horizontal scroll */
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 10px var(--color-success);
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(3rem, 5vw, 4.5rem);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    text-align: left;
    margin-left: 0;
    margin-bottom: var(--space-xl);
    font-size: var(--text-lg);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
  }

  .install-block {
    background: var(--bg-code);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    box-shadow: var(--shadow-glow);
  }

  .install-command {
    color: var(--accent-primary);
  }

  .copy-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 4px;
    transition: color var(--transition-fast);
  }
  .copy-btn:hover { color: var(--accent-primary); }

  .btn-primary {
    background: var(--text-heading);
    color: var(--bg-primary);
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  .btn-primary:hover {
    background: var(--text-secondary);
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .text-success { color: var(--color-success); }
  .text-accent { color: var(--accent-primary); }

  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 600px;
    justify-self: center;
  }

  .terminal-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: conic-gradient(from 180deg at 50% 50%, rgba(0, 229, 255, 0) 0deg, rgba(0, 229, 255, 0.1) 180deg, rgba(0, 229, 255, 0) 360deg);
    filter: blur(40px);
    border-radius: 50%;
    z-index: -1;
    animation: rotate 10s linear infinite;
  }

  @keyframes rotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-4xl);
    }

    .hero-content {
      margin: 0 auto;
    }

    .hero-subtitle {
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-trust {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-visual {
      justify-self: center;
    }
  }
</style>
