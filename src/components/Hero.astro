---
import TerminalDemo from './TerminalDemo.astro';
---

<section class="hero section reveal" id="install">
  <div class="hero-container container">
    
    <div class="hero-content">
      <!-- Badge -->
      <div class="hero-badge reveal delay-100">
        <span class="badge-dot"></span>
        <span>v1.1.0 — Enterprise Ready</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-title reveal delay-200" style="text-wrap: balance;">
        Never leak a <span class="accent-text">corporate commit</span> again.
      </h1>

      <!-- Subheadline -->
      <p class="hero-subtitle reveal delay-300">
        GitSetu is a zero-dependency orchestration engine that automatically routes SSH keys and credentials based on your directory. Enforce Zero-Trust identity for developers and CI/CD pipelines.
      </p>

      <!-- CTA & Command -->
      <div class="hero-actions reveal delay-300">
        <copy-button class="install-block group">
          <code class="install-command" id="install-cmd" tabindex="0">curl -sL https://gitsetu.bhaskarjha.dev/install | bash</code>
          <button class="copy-btn" aria-label="Copy install command" type="button">
            <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </copy-button>
        <a href="/docs/getting-started/quickstart" class="btn btn-primary">
          Read Docs 
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust reveal delay-300">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Zero Trust
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          FIDO2 Ready
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          Bash 3.2 Core
        </div>
      </div>
    </div>

    <!-- Product As Demo (Shifted Top-Right) -->
    <div class="hero-visual reveal delay-200">
      <div class="mesh-gradient"></div>
      <div class="terminal-glow"></div>
      <!-- Interactive Terminal Setup Demo -->
      <TerminalDemo />
    </div>

  </div>
</section>

<script>
  class CopyButton extends HTMLElement {
    private timeoutId: number | null = null;

    connectedCallback() {
      const copyBtn = this.querySelector('.copy-btn') as HTMLButtonElement;
      const installCmd = this.querySelector('.install-command') as HTMLElement;
      const copyIcon = this.querySelector('.copy-icon') as HTMLElement;
      const checkIcon = this.querySelector('.check-icon') as HTMLElement;

      copyBtn?.addEventListener('click', async () => {
        if (this.timeoutId) {
          clearTimeout(this.timeoutId);
        }
        
        try {
          await navigator.clipboard.writeText(installCmd?.textContent?.trim() || '');
          if (copyIcon) copyIcon.style.display = 'none';
          if (checkIcon) checkIcon.style.display = 'block';
          
          this.timeoutId = window.setTimeout(() => {
            if (copyIcon) copyIcon.style.display = 'block';
            if (checkIcon) checkIcon.style.display = 'none';
            this.timeoutId = null;
          }, 2000);
        } catch {
          const range = document.createRange();
          if (installCmd) range.selectNodeContents(installCmd);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
      });
    }
  }

  if (!customElements.get('copy-button')) {
    customElements.define('copy-button', CopyButton);
  }
</script>

<style>
  .hero {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-4xl);
    position: relative;
  }

  /* Fluid Container Architecture */
  .hero-container {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-3xl);
    align-items: start;
    position: relative;
    z-index: 10;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-bottom: var(--space-xl);
    backdrop-filter: blur(10px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 10px var(--color-success);
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-title {
    /* Using clamp for true fluid typography */
    font-size: clamp(2rem, 8vw, 4.5rem);
    margin-bottom: var(--space-lg);
    line-height: 1.05;
  }

  .hero-subtitle {
    margin-bottom: var(--space-2xl);
    font-size: var(--text-lg);
    color: #d4d4d8;
    max-width: 95%;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    width: 100%;
  }

  copy-button.install-block {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
    min-width: 0;
    width: 100%;
    gap: var(--space-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  copy-button.install-block:hover {
    border-color: var(--border-accent);
    box-shadow: var(--shadow-glow);
  }

  .install-command {
    display: block;
    flex: 1;
    min-width: 0;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    text-align: left;
  }
  .install-command::-webkit-scrollbar { display: none; }

  .copy-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    transition: color var(--transition-fast);
  }
  .copy-btn:hover { color: var(--text-primary); }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--gradient-accent);
    color: #000000;
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-weight: 700;
    box-shadow: 0 0 20px var(--accent-glow-strong);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px var(--accent-primary);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .text-success { color: var(--color-success); }
  .text-accent { color: var(--accent-primary); }

  /* Hero Visual - Product as Demo */
  .hero-visual {
    position: relative;
    width: 100%;
    align-self: start;
    margin-top: 0;
    container-type: inline-size;
    perspective: 1000px;
  }

  .mesh-gradient {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle at 20% 30%, rgba(0, 229, 255, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(255, 189, 46, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(39, 201, 63, 0.1) 0%, transparent 60%);
    filter: blur(40px);
    z-index: -2;
    animation: slowMesh 15s ease-in-out infinite alternate;
  }

  .terminal-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    aspect-ratio: 1/1;
    background: conic-gradient(from 180deg at 50% 50%, rgba(0, 229, 255, 0) 0deg, rgba(0, 229, 255, 0.15) 180deg, rgba(0, 229, 255, 0) 360deg);
    filter: blur(60px);
    border-radius: 50%;
    z-index: -1;
    animation: rotate 12s linear infinite;
  }

  @keyframes rotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @keyframes slowMesh {
    0% { transform: translate(-50%, -50%) scale(1) rotate(0deg); }
    100% { transform: translate(-50%, -50%) scale(1.1) rotate(5deg); }
  }

  .hero-content, .hero-visual {
    min-width: 0; /* CRITICAL: Prevents CSS Grid blowout on mobile */
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
      gap: var(--space-4xl);
    }
    .hero-content {
      align-items: center;
      text-align: center;
    }
    .hero-subtitle {
      max-width: 100%;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-trust {
      justify-content: center;
    }
  }
  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary {
      justify-content: center;
    }
  }
</style>
